{
  "suite": "full",
  "description": "Every scenario of docs/DESIGN.md section 16.3 that is feasible on a 16 GB, 8-core laptop with synthetic data. Runs in listed order; later runs reuse index files written by earlier ones.",
  "repeat": 1,
  "runs": [
    {
      "id": "kernels",
      "suite": "kernels",
      "tool": "vf_micro_bench",
      "repeat": 1,
      "args": [
        "--benchmark_filter=Bench(Dot|L2sq|Norm2)",
        "--benchmark_repetitions=5",
        "--benchmark_min_time=0.2s",
        "--benchmark_report_aggregates_only=true",
        "--benchmark_out={out}",
        "--benchmark_out_format=json"
      ]
    },
    {
      "id": "topk",
      "suite": "topk",
      "tool": "vf_micro_bench",
      "repeat": 1,
      "args": [
        "--benchmark_filter=BenchTopK",
        "--benchmark_repetitions=5",
        "--benchmark_min_time=0.1s",
        "--benchmark_report_aggregates_only=true",
        "--benchmark_out={out}",
        "--benchmark_out_format=json"
      ]
    },
    {
      "id": "ablation-visited",
      "suite": "ablation",
      "tool": "vf_micro_bench",
      "repeat": 1,
      "args": [
        "--benchmark_filter=BenchVisited",
        "--benchmark_repetitions=5",
        "--benchmark_min_time=0.1s",
        "--benchmark_report_aggregates_only=true",
        "--benchmark_out={out}",
        "--benchmark_out_format=json"
      ]
    },
    {
      "id": "exact-n{n}-d{dim}-{simd}",
      "suite": "exact",
      "tool": "vf_bench",
      "repeat": 1,
      "matrix": {
        "n": [
          10000,
          100000
        ],
        "dim": [
          128,
          384,
          768,
          1536
        ],
        "simd": [
          "scalar",
          "avx2"
        ]
      },
      "env": {
        "VF_SIMD": "{simd}"
      },
      "args": [
        "--scenario",
        "exact",
        "--n",
        "{n}",
        "--dim",
        "{dim}",
        "--queries",
        "500",
        "--k",
        "10",
        "--threads",
        "1,16",
        "--repeat",
        "3",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "exact-n1000000-d{dim}-{simd}",
      "suite": "exact",
      "tool": "vf_bench",
      "repeat": 1,
      "matrix": {
        "dim": [
          128,
          384,
          768
        ],
        "simd": [
          "scalar",
          "avx2"
        ]
      },
      "env": {
        "VF_SIMD": "{simd}"
      },
      "args": [
        "--scenario",
        "exact",
        "--n",
        "1000000",
        "--dim",
        "{dim}",
        "--queries",
        "50",
        "--k",
        "10",
        "--threads",
        "1,16",
        "--repeat",
        "1",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "sweep-M{M}-efc{efc}",
      "suite": "hnsw-sweep",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "M": [
          8,
          16,
          32,
          48
        ],
        "efc": [
          100,
          200,
          400
        ]
      },
      "args": [
        "--n",
        "100000",
        "--dim",
        "128",
        "--queries",
        "1000",
        "--k",
        "10",
        "--M",
        "{M}",
        "--ef-construction",
        "{efc}",
        "--skip-flat-timing",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "sweep-M16-efc200-k{k}",
      "suite": "hnsw-sweep",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "k": [
          1,
          100
        ]
      },
      "args": [
        "--n",
        "100000",
        "--dim",
        "128",
        "--queries",
        "1000",
        "--k",
        "{k}",
        "--M",
        "16",
        "--ef-construction",
        "200",
        "--skip-flat-timing",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "scale-n{n}-d{dim}",
      "suite": "scale",
      "tool": "vf_bench",
      "repeat": 1,
      "matrix": {
        "n": [
          10000,
          100000,
          1000000
        ],
        "dim": [
          128,
          384,
          768,
          1536
        ]
      },
      "exclude": [
        {
          "n": 1000000,
          "dim": 1536
        }
      ],
      "args": [
        "--scenario",
        "build",
        "--n",
        "{n}",
        "--dim",
        "{dim}",
        "--queries",
        "500",
        "--k",
        "10",
        "--threads",
        "16",
        "--no-coarse-baseline",
        "--batch",
        "10000",
        "--ef-search",
        "10,16,32,64,128,256,512",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "save-hnsw-100k-d{dim}",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 1,
      "matrix": {
        "dim": [
          128,
          768
        ]
      },
      "args": [
        "--scenario",
        "save",
        "--n",
        "100000",
        "--dim",
        "{dim}",
        "--index",
        "hnsw",
        "--build-threads",
        "16",
        "--index-file",
        "{work}/hnsw_100k_d{dim}.vfidx",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "save-flat-100k-d128",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 1,
      "args": [
        "--scenario",
        "save",
        "--n",
        "100000",
        "--dim",
        "128",
        "--index",
        "flat",
        "--index-file",
        "{work}/flat_100k_d128.vfidx",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "save-flat-1m-d768",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 1,
      "args": [
        "--scenario",
        "save",
        "--n",
        "1000000",
        "--dim",
        "768",
        "--index",
        "flat",
        "--index-file",
        "{work}/flat_1m_d768.vfidx",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "load-flat-1m-d768-{mode}",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "mode": [
          "heap",
          "mmap"
        ]
      },
      "args": [
        "--scenario",
        "load",
        "--index-file",
        "{work}/flat_1m_d768.vfidx",
        "--load-mode",
        "{mode}",
        "--queries",
        "20",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "load-flat-1m-d768-mmap-prefault",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 3,
      "args": [
        "--scenario",
        "load",
        "--index-file",
        "{work}/flat_1m_d768.vfidx",
        "--load-mode",
        "mmap",
        "--prefault",
        "--queries",
        "20",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "load-hnsw-100k-d768-{mode}",
      "suite": "storage",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "mode": [
          "heap",
          "mmap"
        ]
      },
      "args": [
        "--scenario",
        "load",
        "--index-file",
        "{work}/hnsw_100k_d768.vfidx",
        "--load-mode",
        "{mode}",
        "--queries",
        "200",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "simd-hnsw-100k-d768-{simd}",
      "suite": "simd",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "simd": [
          "scalar",
          "avx2"
        ]
      },
      "args": [
        "--index-file",
        "{work}/hnsw_100k_d768.vfidx",
        "--dim",
        "768",
        "--queries",
        "1000",
        "--simd",
        "{simd}",
        "--ef-search",
        "16,32,64,128,256",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "ablation-prefetch-{p}",
      "suite": "ablation",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "p": [
          "on",
          "off"
        ]
      },
      "args": [
        "--index-file",
        "{work}/hnsw_100k_d768.vfidx",
        "--dim",
        "768",
        "--queries",
        "1000",
        "--prefetch",
        "{p}",
        "--skip-flat-timing",
        "--ef-search",
        "16,32,64,128,256",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "ablation-selection-{sel}",
      "suite": "ablation",
      "tool": "vf_bench",
      "repeat": 1,
      "matrix": {
        "sel": [
          "heuristic",
          "simple"
        ]
      },
      "args": [
        "--n",
        "100000",
        "--dim",
        "128",
        "--queries",
        "1000",
        "--selection",
        "{sel}",
        "--skip-flat-timing",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "threads-search-hnsw-100k-d128",
      "suite": "threads",
      "tool": "vf_bench",
      "repeat": 3,
      "args": [
        "--scenario",
        "threads",
        "--index-file",
        "{work}/hnsw_100k_d128.vfidx",
        "--queries",
        "20000",
        "--ef-search",
        "64",
        "--threads",
        "1,2,4,8,12,16",
        "--repeat",
        "5",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "threads-search-flat-100k-d128",
      "suite": "threads",
      "tool": "vf_bench",
      "repeat": 3,
      "args": [
        "--scenario",
        "threads",
        "--index-file",
        "{work}/flat_100k_d128.vfidx",
        "--queries",
        "2000",
        "--threads",
        "1,2,4,8,12,16",
        "--repeat",
        "5",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "threads-build-hnsw-100k-d128",
      "suite": "threads",
      "tool": "vf_bench",
      "repeat": 3,
      "args": [
        "--scenario",
        "build",
        "--n",
        "100000",
        "--dim",
        "128",
        "--queries",
        "500",
        "--threads",
        "1,2,4,8,16",
        "--batch",
        "10000",
        "--ef-search",
        "32,64",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "ingest-hnsw-100k-d128-{mode}-w{w}",
      "suite": "ingest",
      "tool": "vf_bench",
      "repeat": 3,
      "matrix": {
        "mode": [
          "coarse",
          "concurrent"
        ],
        "w": [
          1,
          4
        ]
      },
      "exclude": [
        {
          "mode": "coarse",
          "w": 4
        }
      ],
      "args": [
        "--scenario",
        "ingest",
        "--n",
        "100000",
        "--dim",
        "128",
        "--index",
        "hnsw",
        "--queries",
        "1000",
        "--ef-search",
        "64",
        "--batch",
        "1000",
        "--concurrency",
        "{mode}",
        "--writer-threads",
        "{w}",
        "--out",
        "{out}"
      ]
    },
    {
      "id": "http-hnsw-100k-d128",
      "suite": "http",
      "tool": "vf_http_bench",
      "repeat": 3,
      "args": [
        "--n",
        "100000",
        "--dim",
        "128",
        "--queries",
        "2000",
        "--ingest",
        "50000",
        "--batch",
        "1000",
        "--out",
        "{out}"
      ]
    }
  ],
  "not_run": [
    {
      "id": "exact-n1000000-d1536",
      "suite": "exact",
      "reason": "6.1 GB of vectors plus the 6.1 GB generated input exceed what fits next to the OS in 15.4 GB RAM without paging."
    },
    {
      "id": "scale-n1000000-d1536",
      "suite": "scale",
      "reason": "Same memory limit as exact-n1000000-d1536 (input, exact ground-truth copy and index)."
    },
    {
      "id": "datasets-real",
      "suite": "hnsw-sweep",
      "reason": "SIFT1M, GloVe-100 and the 384-d/1536-d embedding sets are downloads that DESIGN §16.2 requires the user to approve; they were not downloaded. tools/datasets/fetch.py and hdf5_to_npy.py prepare them."
    },
    {
      "id": "storage-cold-cache",
      "suite": "storage",
      "reason": "Windows offers no supported way to evict the file cache without a reboot; all load timings are warm-cache."
    },
    {
      "id": "threads-pinning",
      "suite": "threads",
      "reason": "Thread affinity is not implemented in vf_bench; the OS scheduler places threads."
    },
    {
      "id": "hnsw-sweep-n1000000",
      "suite": "hnsw-sweep",
      "reason": "The 12-configuration grid runs serial builds (graph statistics come from the single-threaded backend); at 1M rows this would take several hours. The 1M point is covered by scale-n1000000-* with a parallel build."
    },
    {
      "id": "external-reference",
      "suite": "hnsw-sweep",
      "reason": "hnswlib/FAISS comparisons are optional (DESIGN §16.1) and were not installed."
    }
  ]
}
